{
  "name": "m8t",
  "version": "0.8.2",
  "description": "A minimalist static site generator, and your best friend",
  "keywords": [
    "html",
    "markdown",
    "mdx",
    "react",
    "static site generator"
  ],
  "license": "MIT",
  "author": {
    "name": "Jason Gedge",
    "email": "jason@gedge.ca"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thegedge/m8t.git"
  },
  "bin": {
    "m8t": "./dist/src/cli/index.js"
  },
  "files": [
    "dist/**/*.{d.ts,js}",
    "LICENSE",
    "package.json",
    "README.md",
    "types/**/*.d.ts"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "pnpm lint:format && pnpm lint:syntax",
    "lint:format": "./scripts/format-with-diff",
    "lint:format:fix": "oxfmt --write .",
    "lint:syntax": "oxlint",
    "lint:syntax:fix": "oxlint --fix .",
    "prepublishOnly": "tsc",
    "tc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "ansi-escapes": "^7.2.0",
    "debug": "^4.4.3",
    "esbuild": "^0.27.2",
    "html-validate": "^10.7.0",
    "inflected": "^2.1.0",
    "mime-types": "^3.0.2",
    "p-debounce": "^5.1.0",
    "p-map": "^7.0.4",
    "postcss": "^8.5.26"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/inflected": "^2.1.3",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "optionalDependencies": {
    "@tailwindcss/nesting": "0.0.0-insiders.565cd3e",
    "@tailwindcss/postcss": "^4.1.11",
    "playwright": "^1.55.1",
    "playwright-core": "^1.55.1",
    "postcss-discard-comments": "^7.0.4"
  }
}
