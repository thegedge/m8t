{
  "name": "m8t",
  "version": "0.7.8",
  "description": "A minimalist static site generator, and your best friend",
  "keywords": [
    "html",
    "markdown",
    "mdx",
    "react",
    "static site generator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thegedge/m8t.git"
  },
  "license": "MIT",
  "author": {
    "name": "Jason Gedge",
    "email": "jason@gedge.ca"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "main": "./dist/src/index.js",
  "bin": {
    "m8t": "./dist/src/cli/index.js"
  },
  "files": [
    "dist/**/*.{d.ts,js}",
    "LICENSE",
    "package.json",
    "README.md",
    "types/**/*.d.ts"
  ],
  "scripts": {
    "lint": "pnpm lint:prettier",
    "lint:prettier": "./scripts/prettier-with-diff",
    "prepublishOnly": "tsc",
    "tc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "update": "ncu --interactive --upgrade",
    "watch": "tsc --watch"
  },
  "overrides": {
    "@nodejs-loaders/tsx": {
      "esbuild": "0.27.2"
    }
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@nodejs-loaders/tsx": "^1.1.2",
    "ansi-escapes": "^7.2.0",
    "debug": "^4.4.3",
    "esbuild": "^0.27.2",
    "html-validate": "^10.7.0",
    "inflected": "^2.1.0",
    "mime-types": "^3.0.2",
    "p-debounce": "^5.1.0",
    "p-map": "^7.0.4",
    "postcss": "^8.5.14"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/inflected": "^2.1.3",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "npm-check-updates": "^19.3.2",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "optionalDependencies": {
    "@tailwindcss/nesting": "0.0.0-insiders.565cd3e",
    "@tailwindcss/postcss": "*",
    "playwright": "*",
    "playwright-core": "*",
    "postcss-discard-comments": "*"
  }
}
